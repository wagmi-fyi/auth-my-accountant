# Neon Postgres connection string
# Auto-injected by Vercel Marketplace integration, or set manually for local dev
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Platform admin API key for firm provisioning
# Generate a strong random string (e.g., openssl rand -hex 32)
ADMIN_API_KEY=your-admin-api-key-here

# Base URL for channel links (no trailing slash)
# Must be set explicitly — never falls back to VERCEL_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public sign-up limits (optional). Sign-ups per caller address per hour, and
# new firms per UTC day. A daily cap of 0 closes sign-up.
SIGNUP_PER_ADDRESS_HOURLY=3
SIGNUP_DAILY_CAP=20

# Local tests only: registers the "test" provider, which calls nothing.
# Ignored in a production build.
# AMA_ENABLE_TEST_PROVIDER=1
